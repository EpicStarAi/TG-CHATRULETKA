PORT=8080
PUBLIC_URL=https://your-domain.example
TELEGRAM_BOT_TOKEN=          # from BotFather; keep server-side only, never commit
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# TURN relay: set by deploy/setup-turn.sh. Credentials are short-lived and given only to signed-in users.
TURN_SECRET=
TURN_URLS=turn:your-domain.example:3478?transport=udp,turn:your-domain.example:3478?transport=tcp,turns:your-domain.example:5349?transport=tcp
VITE_API_URL=https://your-domain.example
VITE_BOT_USERNAME=your_bot_username
